{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project1 (Debug x64)",
            "type": "shell",
            "command": "${workspaceFolder}\\scripts\\build.bat",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/c"]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build Project1 (Release x64)",
            "type": "shell",
            "command": "${workspaceFolder}\\scripts\\build.bat",
            "args": ["release"],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/c"]
                }
            },
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Kill Project1.exe (unlock linker)",
            "type": "shell",
            "command": "${workspaceFolder}\\scripts\\kill-game.bat",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/c"]
                }
            },
            "problemMatcher": []
        }
    ]
}
